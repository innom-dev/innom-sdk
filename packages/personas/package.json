{
  "name": "@innom/personas",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Demo device-capability personas for the Innom age-assurance SDK.",
  "repository": {
    "type": "git",
    "url": "https://github.com/innom-dev/innom-sdk.git",
    "directory": "packages/personas"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@innom/schemas": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
